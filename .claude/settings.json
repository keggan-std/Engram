{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx vitest run *)",
      "Bash(npm test)",
      "Bash(npm run surface:check)",
      "Bash(npm run http-surface:check)",
      "Bash(npm run state:check)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-branches.mjs",
            "timeout": 15,
            "statusMessage": "Checking branch policy..."
          }
        ]
      }
    ]
  }
}
